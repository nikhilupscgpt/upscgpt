generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  // Platform Access (Global for UPSCGPT)
  role               String? @default("USER") // ADMIN, USER
  tier               String? @default("FREE") // FREE, PRO
  validUntil         DateTime? // Date for manual access expiry
  
  // Razorpay
  razorpayCustomerId String? @unique
  
  favorites       FavoriteEntry[]
  
  // Admin Login Support
  username String? @unique
  password String?
  createdAt DateTime @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  razorpaySubId     String   @unique
  razorpayPlanId    String
  status            String   // active, halted, cancelled, completed
  currentStart      DateTime
  currentEnd        DateTime
}

model FavoriteEntry {
  id      String   @id @default(cuid())
  userId  String
  entryId String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry   MapEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, entryId])
}

model MapEntry {
  id        String   @id @default(cuid())
  lat       Float?
  lon       Float?
  name      String
  category  String
  tags      String?
  year      Int?
  shape     String?
  prelims        String?
  mains          String?
  india          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  
  lastNewsDate   DateTime?
  newsMentions   String?
  
  favoritedBy  FavoriteEntry[]

  @@index([name])
  @@index([category])
  @@unique([name, lat, lon])
}

model ActionLog {
  id        String   @id @default(cuid())
  action    String   // SCRAPE_RUN, USER_MOD, CONTENT_EDIT
  details   String?
  userId    String?
  createdAt DateTime @default(now())
}

