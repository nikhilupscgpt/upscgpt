// WARNING: searchVector columns are Unsupported tsvector — always run init scripts after db push.
// This schema uses Unsupported types for PostgreSQL full-text search.
// Standard prisma db push will create the columns but NOT the GIN indexes or ts_vector data.

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                 String          @id @default(cuid())
  name               String?
  email              String?         @unique
  emailVerified      DateTime?
  image              String?
  role               String?         @default("USER")
  tier               String?         @default("FREE")
  validUntil         DateTime?
  razorpayCustomerId String?         @unique
  username           String?         @unique
  password           String?
  createdAt          DateTime        @default(now())
  preferences        Json?           @default("{}")
  examYear           Int?
  accounts           Account[]
  logs               ActionLog[]
  bookmarks          Bookmark[]
  favorites          FavoriteEntry[]
  followedIssues     IssueFollow[]
  issueProgress      IssueProgress[]
  payments           PaymentLog[]
  QuizAttempt        QuizAttempt[]
  sessions           Session[]
  notes              UserNote[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  code       String?
  expires    DateTime
  type       String   @default("EMAIL_OTP")

  @@unique([identifier, token])
}

model Subscription {
  id             String   @id @default(cuid())
  userId         String   @unique
  razorpaySubId  String   @unique
  razorpayPlanId String
  status         String
  currentStart   DateTime
  currentEnd     DateTime
}

model FavoriteEntry {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  createdAt DateTime @default(now())
  entry     MapEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
}

model MapEntry {
  id                       String          @id @default(cuid())
  lat                      Float?
  lon                      Float?
  name                     String
  name_hi                  String?
  name_mr                  String?
  category                 String
  tags                     String?
  year                     Int?
  shape                    String?
  prelims                  String?
  prelims_hi               String?
  prelims_mr               String?
  mains                    String?
  mains_hi                 String?
  mains_mr                 String?
  india                    String?
  india_hi                 String?
  india_mr                 String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @default(now()) @updatedAt
  lastNewsDate             DateTime?
  newsMentions             String?
  aiNodeSummaryFollowups   String?
  aiNodeSummaryMarkdown    String?
  aiNodeSummaryMarkdown_hi String?
  aiNodeSummaryMarkdown_mr String?
  aiNodeSummarySourceHash  String?
  aiNodeSummaryTitle       String?
  aiNodeSummaryTitle_hi    String?
  aiNodeSummaryTitle_mr    String?
  aiNodeSummaryUpdatedAt   DateTime?
  aiNewsSummaryFollowups   String?
  aiNewsSummaryMarkdown    String?
  aiNewsSummaryMarkdown_hi String?
  aiNewsSummaryMarkdown_mr String?
  aiNewsSummarySourceHash  String?
  aiNewsSummaryTitle       String?
  aiNewsSummaryTitle_hi    String?
  aiNewsSummaryTitle_mr    String?
  aiNewsSummaryUpdatedAt   DateTime?
  admRegion                String?
  capital                  String?
  continent                String?
  geoGroup                 String?
  worldPart                String?         @default("POLITICAL")
  isCurrentAffairs         Boolean?        @default(false)
  isLandlocked             Boolean?        @default(false)
  mountainType             String?
  nodeSubType              String?
  organizations            String?
  parentCountry            String?
  riverOutflow             String?
  seaBorders               String?
  upscFrequency            Int?
  countriesSpread          String?
  highestPeak              String?
  favoritedBy              FavoriteEntry[]

  @@unique([name, lat, lon])
  @@index([name])
  @@index([category])
  @@index([worldPart])
  @@index([nodeSubType])
}

model Organization {
  id             String   @id @default(cuid())
  name           String   @unique
  name_hi        String?
  name_mr        String?
  shortName      String
  category       String
  members        String
  hqCity         String?
  hqLat          Float?
  hqLon          Float?
  founded        Int?
  description    String?
  description_hi String?
  description_mr String?
  upscContext    String?
  upscContext_hi String?
  upscContext_mr String?
  indiaRole      String?
  indiaRole_hi   String?
  indiaRole_mr   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([category])
  @@index([shortName])
}

/// The central knowledge node. 545 pre-seeded from UPSC syllabus (GS1–GS4).
/// News items and editorials attach TO Issues. Every new attachment triggers
/// a background rebuild of cumulativeSummary.
model Issue {
  id                     String                 @id @default(cuid())
  title                  String
  title_hi               String?
  title_mr               String?
  slug                   String                 @unique
  domain                 String
  topic                  String
  topic_hi               String?
  topic_mr               String?
  category               IssueCategory
  gsPapers               String[]
  nodeType               IssueNodeType          @default(NEWS)
  status                 IssueStatus            @default(ACTIVE)
  backgroundNote         String?
  backgroundNote_hi      String?
  backgroundNote_mr      String?
  cumulativeSummary      String?
  cumulativeSummary_hi   String?
  cumulativeSummary_mr   String?
  valueAddition          String?
  valueAddition_hi       String?
  valueAddition_mr       String?
  possibleQuestions      String?
  possibleQuestions_hi   String?
  possibleQuestions_mr   String?
  prelimsNote            Json?
  mainsNote              Json?
  searchVector           Unsupported("tsvector")?
  mainsFacts             String?
  imageUrl               String?
  embedding              Unsupported("vector")?
  orderIndex             Int                    @default(0)
  lastUpdatedAt          DateTime               @updatedAt
  createdAt              DateTime               @default(now())
  parentIssueId          String?
  mainsFacts_hi          String?
  mainsFacts_mr          String?
  mainsNote_hi           String?
  mainsNote_mr           String?
  prelimsNote_hi         String?
  prelimsNote_mr         String?
  articles               Article[]
  editorials             Editorial[]
  parentIssue            Issue?                 @relation("SubNodes", fields: [parentIssueId], references: [id])
  subNodes               Issue[]                @relation("SubNodes")
  followers              IssueFollow[]
  userProgress           IssueProgress[]
  nodeContent            NodeContent?
  pyqLinks               PYQLink[]
  testPacks              TestPack[]
  timelineEvents         TimelineEvent[]
  userNotes              UserNote[]
  questions              Question[]
  metadata               Json?
  newsStreaks            NewsStreak[]           @relation("NewsStreakIssues")
  Issue_IssueRelations_A Issue[]                @relation("IssueRelations")
  Issue_IssueRelations_B Issue[]                @relation("IssueRelations")
  subjectContents        SubjectContent[]

  @@index([category])
  @@index([domain])
  @@index([nodeType])
  @@index([status])
  @@index([slug])
  @@index([orderIndex])
  @@index([title])
}

model NodeContent {
  id              String   @id @default(cuid())
  issueId         String   @unique
  prelimsNote     String?
  mainsNote       String?
  facts           Json?    @default("[]")
  caseStudies     Json?    @default("[]")
  recommendations Json?    @default("[]")
  status          String   @default("DRAFT")
  lastEditedBy    String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  issue           Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

/// Manually added news items, linked to an Issue.
/// structuredData holds the full Gemma 26B analysis JSON.
model Article {
  id              String           @id @default(cuid())
  issueId         String
  title           String
  title_hi        String?
  title_mr        String?
  url             String?          @unique
  source          String?
  contentType     ContentType      @default(NEWS)
  examStage       ExamStage?
  importanceScore Int              @default(1)
  rawContent      String?
  rawContent_hi   String?
  rawContent_mr   String?
  structuredData  Json?
  status          ProcessingStatus @default(PENDING)
  addedManually   Boolean          @default(true)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  issue           Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  newsStreakId    String?
  newsStreak      NewsStreak?      @relation(fields: [newsStreakId], references: [id], onDelete: SetNull)
  timelineEvents  TimelineEvent[]
  userNotes       UserNote[]

  @@index([issueId])
  @@index([status])
  @@index([source])
  @@index([contentType])
  @@index([publishedAt])
}

/// Manually added editorials, linked to an Issue.
/// structuredData holds the editorial-specific Gemma 26B analysis JSON.
model Editorial {
  id              String           @id @default(cuid())
  issueId         String
  title           String
  title_hi        String?
  title_mr        String?
  url             String?
  author          String?
  source          String?
  importanceScore Int              @default(1)
  rawContent      String?
  rawContent_hi   String?
  rawContent_mr   String?
  structuredData  Json?
  status          ProcessingStatus @default(PENDING)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  issue           Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  newsStreakId    String?
  newsStreak      NewsStreak?      @relation(fields: [newsStreakId], references: [id], onDelete: SetNull)
  userNotes       UserNote[]

  @@index([issueId])
  @@index([status])
  @@index([source])
}

/// Auto-generated chronological event thread per Issue.
/// Created whenever a new Article or Editorial is attached.
model TimelineEvent {
  id        String   @id @default(cuid())
  issueId   String
  date      DateTime
  eventText String
  sourceUrl String?
  itemType  String
  refId     String?
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  article   Article? @relation(fields: [refId], references: [id])

  @@index([issueId])
  @@index([date])
  @@index([itemType])
}

/// Links Issues to Past Year Questions.
/// Built via pgvector semantic search + Gemma 26B validation.
model PYQLink {
  id            String   @id @default(cuid())
  issueId       String
  paperType     String
  year          Int
  gsTag         String?
  questionText  String
  relevanceNote String?
  howToUse      String?
  score         Float?
  createdAt     DateTime @default(now())
  issue         Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([paperType])
  @@index([year])
}

/// Logs all engine operations: ingestion, processing, summary rebuilds, errors.
model ActionLog {
  id         String   @id @default(cuid())
  action     String
  createdAt  DateTime @default(now())
  entityId   String?
  entityType String?
  message    String?
  status     String   @default("SUCCESS")
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model RegionInsightCache {
  id                 String   @id @default(cuid())
  regionKey          String
  mode               String
  title              String
  contextLabel       String
  markdown           String
  suggestedFollowups String?
  sourceHash         String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@unique([regionKey, mode])
  @@index([regionKey])
  @@index([mode])
}

model QuizPack {
  id                 String   @id @default(cuid())
  scopeType          String
  scopeId            String
  mode               String
  title              String
  contextLabel       String
  markdown           String
  suggestedFollowups String?
  sourceHash         String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@unique([scopeType, scopeId, mode])
  @@index([scopeType, scopeId])
  @@index([mode])
}

model CommunicationLog {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  channel   String
  status    String
  content   String?
  recipient String
  createdAt DateTime @default(now())
}

model PaymentLog {
  id         String   @id @default(cuid())
  userId     String
  razorpayId String   @unique
  amount     Int
  currency   String   @default("INR")
  status     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model PlatformConfig {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model SubjectContent {
  id              String                 @id @default(cuid())
  subject         String
  examType        String
  title           String
  contentMarkdown String
  embedding       Unsupported("vector")?
  sourceUrl       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt
  isOptional      Boolean                @default(false)
  language        String                 @default("en")
  exam            String                 @default("BOTH")
  optionalId      String?
  optionalSubject OptionalSubject?       @relation(fields: [optionalId], references: [id])
  issueId         String?
  issue           Issue?                 @relation(fields: [issueId], references: [id])

  @@index([subject])
  @@index([examType])
  @@index([optionalId])
  @@index([issueId])
}

model OptionalSubject {
  id          String                 @id @default(cuid())
  name        String                 @unique
  slug        String                 @unique
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @default(now()) @updatedAt
  pyqs        PreviousYearQuestion[]
  contents    SubjectContent[]

  @@index([slug])
}

/// Tracks a user's mastery of the 545 syllabus nodes.
model IssueProgress {
  id            String         @id @default(cuid())
  userId        String
  issueId       String
  status        ProgressStatus @default(UNSTARTED)
  readSummary   Boolean        @default(false)
  viewedNews    Boolean        @default(false)
  solvedPYQs    Boolean        @default(false)
  solvedMCQs    Boolean        @default(false)
  lastStudiedAt DateTime?
  timeSpentSecs Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  issue         Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId])
  @@index([userId, status])
}

model Question {
  id             String     @id @default(cuid())
  text           String
  text_hi        String?
  text_mr        String?
  options        Json
  options_hi     Json?
  options_mr     Json?
  correctLabel   String
  explanation    String
  explanation_hi String?
  explanation_mr String?
  difficulty     String     @default("MEDIUM")
  domain         String
  gsPaper        String?
  tags           String[]
  issueId        String?
  issue          Issue?     @relation(fields: [issueId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  testPacks      TestPack[] @relation("TestPackQuestions")
}

model TestPack {
  id               String        @id @default(cuid())
  title            String
  title_hi         String?
  title_mr         String?
  description      String?
  description_hi   String?
  description_mr   String?
  type             String        @default("PRACTICE")
  subType          String?       @default("FULL_LENGTH")
  durationMins     Int           @default(0)
  passingScore     Int           @default(70)
  negativeMarking  Float         @default(0.33)
  marksPerQuestion Float         @default(2.0)
  issueId          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  attempts         QuizAttempt[]
  issue            Issue?        @relation(fields: [issueId], references: [id])
  questions        Question[]    @relation("TestPackQuestions")
}

model QuizAttempt {
  id            String   @id @default(cuid())
  userId        String
  testPackId    String
  score         Int
  timeTakenSecs Int
  breakdown     Json
  createdAt     DateTime @default(now())
  testPack      TestPack @relation(fields: [testPackId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Allows users to subscribe to real-time updates for an evolving issue.
model IssueFollow {
  id        String   @id @default(cuid())
  userId    String
  issueId   String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId])
}

/// AI-assisted or manual personal notes, linked to any content entity.
model UserNote {
  id            String      @id @default(cuid())
  userId        String
  content       String      @db.Text
  isAiGenerated Boolean     @default(false)
  // Polymorphic parent — exactly one should be set
  issueId       String?
  articleId     String?
  editorialId   String?
  streakId      String?
  // Auto-detected metadata
  subject       String?
  topic         String?
  linkedNodeIds String[]    @default([])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  // Relations
  issue         Issue?      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  article       Article?    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editorial     Editorial?  @relation(fields: [editorialId], references: [id], onDelete: Cascade)
  streak        NewsStreak? @relation(fields: [streakId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, issueId])
  @@index([userId, articleId])
  @@index([userId, editorialId])
  @@index([userId, streakId])
}

/// Generic bookmarking for specific Articles or Editorials within an Issue.
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  itemType  String
  itemId    String
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
}

model PreviousYearQuestion {
  id           String                 @id @default(uuid())
  paper        String
  optionalId   String?
  subject      String
  year         Int
  questionText String
  marks        Int?
  modelAnswer  String?
  embedding    Unsupported("vector")?
  searchVector   Unsupported("tsvector")?
  metadata       Json?
  language     String                 @default("en")
  exam         String                 @default("UPSC")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  optional     OptionalSubject?       @relation(fields: [optionalId], references: [id])

  @@index([paper])
  @@index([subject])
  @@index([year])
}

enum IssueCategory {
  POLITY
  GOVERNANCE
  INTERNATIONAL_RELATIONS
  ECONOMY
  AGRICULTURE
  SCIENCE_TECHNOLOGY
  ENVIRONMENT
  INTERNAL_SECURITY
  SOCIETY
  ANCIENT_INDIA
  MEDIEVAL_INDIA
  MODERN_INDIA
  ART_CULTURE
  HISTORY
  GEOGRAPHY
  CULTURE
  ETHICS
  DISASTER_MANAGEMENT
  CURRENT_AFFAIRS
  CSAT
  OPTIONAL
}

enum IssueNodeType {
  NEWS
  CONCEPTUAL
  STATIC
  MAINS_QUESTION
}

enum IssueStatus {
  ACTIVE
  DORMANT
  ARCHIVED
}

enum ContentType {
  NEWS
  PIB
  REPORT
  THE_HINDU_TEXT_AND_CONTEXT
  INDIAN_EXPRESS_EXPLAINED
}

enum ExamStage {
  PRELIMS_ONLY
  MAINS_ONLY
  BOTH
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum ProgressStatus {
  UNSTARTED
  READING
  MASTERED
  REVISION_NEEDED
}

model NewsStreak {
  id               String       @id @default(cuid())
  title            String
  title_hi         String?
  title_mr         String?
  slug             String       @unique
  livingSummary    String?      @db.Text
  livingSummary_hi String?      @db.Text
  livingSummary_mr String?      @db.Text
  status           String       @default("ACTIVE") // ACTIVE, ARCHIVED
  importanceScore  Int          @default(1)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relationships
  articles         Article[]
  editorials       Editorial[]
  
  // Linkages to static syllabus Issues
  issues           Issue[]      @relation("NewsStreakIssues")
  userNotes        UserNote[]
}
