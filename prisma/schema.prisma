generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                 String          @id @default(cuid())
  name               String?
  email              String?         @unique
  emailVerified      DateTime?
  image              String?
  role               String?         @default("USER")
  tier               String?         @default("FREE")
  validUntil         DateTime?
  razorpayCustomerId String?         @unique
  username           String?         @unique
  password           String?
  createdAt          DateTime        @default(now())
  preferences        Json?           @default("{}")
  examYear           Int?
  accounts           Account[]
  logs               ActionLog[]
  bookmarks          Bookmark[]
  favorites          FavoriteEntry[]
  followedIssues     IssueFollow[]
  issueProgress      IssueProgress[]
  payments           PaymentLog[]
  sessions           Session[]
  notes              UserNote[]
  QuizAttempt        QuizAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  code       String?  // The 6-digit OTP
  expires    DateTime
  type       String   @default("EMAIL_OTP") // EMAIL_OTP, SMS_OTP, PASSWORD_RESET

  @@unique([identifier, token])
}

model Subscription {
  id             String   @id @default(cuid())
  userId         String   @unique
  razorpaySubId  String   @unique
  razorpayPlanId String
  status         String
  currentStart   DateTime
  currentEnd     DateTime
}

model FavoriteEntry {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  createdAt DateTime @default(now())
  entry     MapEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
}

model MapEntry {
  id                      String          @id @default(cuid())
  lat                     Float?
  lon                     Float?
  name                    String
  name_hi                 String?
  name_mr                 String?
  category                String
  tags                    String?
  year                    Int?
  shape                   String?
  prelims                 String?
  prelims_hi              String?
  prelims_mr              String?
  mains                   String?
  mains_hi                String?
  mains_mr                String?
  india                   String?
  india_hi                String?
  india_mr                String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @default(now()) @updatedAt
  lastNewsDate            DateTime?
  newsMentions            String?
  aiNodeSummaryFollowups  String?
  aiNodeSummaryMarkdown   String?
  aiNodeSummaryMarkdown_hi String?
  aiNodeSummaryMarkdown_mr String?
  aiNodeSummarySourceHash String?
  aiNodeSummaryTitle      String?
  aiNodeSummaryTitle_hi   String?
  aiNodeSummaryTitle_mr   String?
  aiNodeSummaryUpdatedAt  DateTime?
  aiNewsSummaryFollowups  String?
  aiNewsSummaryMarkdown   String?
  aiNewsSummaryMarkdown_hi String?
  aiNewsSummaryMarkdown_mr String?
  aiNewsSummarySourceHash String?
  aiNewsSummaryTitle      String?
  aiNewsSummaryTitle_hi   String?
  aiNewsSummaryTitle_mr   String?
  aiNewsSummaryUpdatedAt  DateTime?
  admRegion               String?
  capital                 String?
  continent               String?
  geoGroup                String?
  worldPart               String?         @default("POLITICAL")
  isCurrentAffairs        Boolean?        @default(false)
  isLandlocked            Boolean?        @default(false)
  mountainType            String?
  nodeSubType             String?
  organizations           String?
  parentCountry           String?
  riverOutflow            String?
  seaBorders              String?
  upscFrequency           Int?
  countriesSpread         String?
  highestPeak             String?
  favoritedBy             FavoriteEntry[]

  @@unique([name, lat, lon])
  @@index([name])
  @@index([category])
  @@index([worldPart])
  @@index([nodeSubType])
}

model Organization {
  id              String   @id @default(cuid())
  name            String   @unique
  name_hi         String?
  name_mr         String?
  shortName       String
  category        String
  members         String
  hqCity          String?
  hqLat           Float?
  hqLon           Float?
  founded         Int?
  description     String?
  description_hi  String?
  description_mr  String?
  upscContext     String?
  upscContext_hi  String?
  upscContext_mr  String?
  indiaRole       String?
  indiaRole_hi    String?
  indiaRole_mr    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([category])
  @@index([shortName])
}

/// The central knowledge node. 545 pre-seeded from UPSC syllabus (GS1–GS4).
/// News items and editorials attach TO Issues. Every new attachment triggers
/// a background rebuild of cumulativeSummary.
model Issue {
  id                   String                 @id @default(cuid())
  title                String
  title_hi             String?
  title_mr             String?
  slug                 String                 @unique
  domain               String
  topic                String
  topic_hi             String?
  topic_mr             String?
  category             IssueCategory
  gsPapers             String[]
  nodeType             IssueNodeType          @default(NEWS)
  status               IssueStatus            @default(ACTIVE)
  backgroundNote       String?
  backgroundNote_hi    String?
  backgroundNote_mr    String?
  cumulativeSummary    String?
  cumulativeSummary_hi String?
  cumulativeSummary_mr String?
  valueAddition        String?
  valueAddition_hi     String?
  valueAddition_mr     String?
  possibleQuestions    String? @db.Text
  possibleQuestions_hi String? @db.Text
  possibleQuestions_mr String? @db.Text
  embedding            Unsupported("vector")?
  orderIndex           Int                    @default(0)
  lastUpdatedAt        DateTime               @updatedAt
  createdAt            DateTime               @default(now())
  articles             Article[]
  editorials           Editorial[]
  followers            IssueFollow[]
  userProgress         IssueProgress[]
  pyqLinks             PYQLink[]
  timelineEvents       TimelineEvent[]
  userNotes            UserNote[]
  optionalId           String?
  optionalSubject      OptionalSubject?       @relation(fields: [optionalId], references: [id])
  testPacks            TestPack[]

  @@index([category])
  @@index([domain])
  @@index([nodeType])
  @@index([status])
  @@index([slug])
}

/// Manually added news items, linked to an Issue.
/// structuredData holds the full Gemma 26B analysis JSON.
model Article {
  id             String           @id @default(cuid())
  issueId        String
  title          String
  title_hi       String?
  title_mr       String?
  url            String?          @unique
  source         String?
  contentType    ContentType      @default(NEWS)
  rawContent     String?
  structuredData Json?
  status         ProcessingStatus @default(PENDING)
  addedManually  Boolean          @default(true)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  issue          Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  timelineEvents TimelineEvent[]

  @@index([issueId])
  @@index([status])
  @@index([source])
  @@index([contentType])
  @@index([publishedAt])
}

/// Manually added editorials, linked to an Issue.
/// structuredData holds the editorial-specific Gemma 26B analysis JSON.
model Editorial {
  id             String           @id @default(cuid())
  issueId        String
  title          String
  title_hi       String?
  title_mr       String?
  url            String?
  author         String?
  source         String?
  rawContent     String?
  structuredData Json?
  status         ProcessingStatus @default(PENDING)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  issue          Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([status])
  @@index([source])
}

/// Auto-generated chronological event thread per Issue.
/// Created whenever a new Article or Editorial is attached.
model TimelineEvent {
  id        String   @id @default(cuid())
  issueId   String
  date      DateTime
  eventText String
  sourceUrl String?
  itemType  String
  refId     String?
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  article   Article? @relation(fields: [refId], references: [id])

  @@index([issueId])
  @@index([date])
  @@index([itemType])
}

/// Links Issues to Past Year Questions.
/// Built via pgvector semantic search + Gemma 26B validation.
model PYQLink {
  id            String   @id @default(cuid())
  issueId       String
  paperType     String
  year          Int
  gsTag         String?
  questionText  String
  relevanceNote String?
  howToUse      String?
  score         Float?
  createdAt     DateTime @default(now())
  issue         Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([paperType])
  @@index([year])
}

/// Logs all engine operations: ingestion, processing, summary rebuilds, errors.
model ActionLog {
  id         String   @id @default(cuid())
  action     String
  createdAt  DateTime @default(now())
  entityId   String?
  entityType String?
  message    String?
  status     String   @default("SUCCESS")
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model RegionInsightCache {
  id                 String   @id @default(cuid())
  regionKey          String
  mode               String
  title              String
  contextLabel       String
  markdown           String
  suggestedFollowups String?
  sourceHash         String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@unique([regionKey, mode])
  @@index([regionKey])
  @@index([mode])
}

model QuizPack {
  id                 String   @id @default(cuid())
  scopeType          String
  scopeId            String
  mode               String
  title              String
  contextLabel       String
  markdown           String
  suggestedFollowups String?
  sourceHash         String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@unique([scopeType, scopeId, mode])
  @@index([scopeType, scopeId])
  @@index([mode])
}

model CommunicationLog {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  channel   String
  status    String
  content   String?
  recipient String
  createdAt DateTime @default(now())
}

model PaymentLog {
  id         String   @id @default(cuid())
  userId     String
  razorpayId String   @unique
  amount     Int
  currency   String   @default("INR")
  status     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model PlatformConfig {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model SubjectContent {
  id              String                 @id @default(cuid())
  subject         String
  examType        String
  title           String
  contentMarkdown String
  embedding       Unsupported("vector")?
  sourceUrl       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt
  isOptional      Boolean                @default(false)
  optionalId      String?
  optionalSubject OptionalSubject?       @relation(fields: [optionalId], references: [id])

  @@index([subject])
  @@index([examType])
  @@index([optionalId])
}

model OptionalSubject {
  id          String                 @id @default(cuid())
  name        String                 @unique
  slug        String                 @unique
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @default(now()) @updatedAt
  contents    SubjectContent[]
  issues      Issue[]
  pyqs        PreviousYearQuestion[]

  @@index([slug])
}

/// Tracks a user's mastery of the 545 syllabus nodes.
model IssueProgress {
  id      String         @id @default(cuid())
  userId  String
  issueId String
  status  ProgressStatus @default(UNSTARTED)

  // Mastery Path Sub-tasks
  readSummary Boolean @default(false)
  viewedNews  Boolean @default(false)
  solvedPYQs  Boolean @default(false)
  solvedMCQs  Boolean @default(false)

  lastStudiedAt DateTime?
  timeSpentSecs Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  issue         Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId])
  @@index([userId, status])
}

model Question {
  id              String   @id @default(cuid())
  text            String   @db.Text
  text_hi         String?  @db.Text
  text_mr         String?  @db.Text
  options         Json // [{label: "a", text: "..."}, ...]
  options_hi      Json?
  options_mr      Json?
  correctLabel    String
  explanation     String   @db.Text
  explanation_hi  String?  @db.Text
  explanation_mr  String?  @db.Text
  difficulty      String   @default("MEDIUM") // EASY, MEDIUM, HARD
  domain          String
  gsPaper         String?
  tags            String[]
  issueId         String? // Optional link to a syllabus node
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  testPacks TestPack[] @relation("TestPackQuestions")
}

model TestPack {
  id               String   @id @default(cuid())
  title            String
  title_hi         String?
  title_mr         String?
  description      String?  @db.Text
  description_hi   String?  @db.Text
  description_mr   String?  @db.Text
  type             String   @default("PRACTICE") // PRACTICE or MOCK
  subType          String?  @default("FULL_LENGTH") // SECTIONAL or FULL_LENGTH
  durationMins     Int      @default(0) // 0 for untimed
  passingScore     Int      @default(70)
  negativeMarking  Float    @default(0.33) // Default for UPSC
  marksPerQuestion Float    @default(2.0)  // Default for UPSC
  issueId          String? // Link to a specific syllabus node
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questions Question[]    @relation("TestPackQuestions")
  attempts  QuizAttempt[]
  issue     Issue?        @relation(fields: [issueId], references: [id])
}

model QuizAttempt {
  id            String   @id @default(cuid())
  userId        String
  testPackId    String
  score         Int
  timeTakenSecs Int
  breakdown     Json // [{questionId: "...", selected: "...", correct: true}, ...]
  createdAt     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testPack TestPack @relation(fields: [testPackId], references: [id], onDelete: Cascade)
}

/// Allows users to subscribe to real-time updates for an evolving issue.
model IssueFollow {
  id        String   @id @default(cuid())
  userId    String
  issueId   String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId])
}

/// AI-assisted or manual personal notes linked to an Issue.
model UserNote {
  id            String   @id @default(cuid())
  userId        String
  issueId       String
  content       String
  isAiGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  issue         Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, issueId])
}

/// Generic bookmarking for specific Articles or Editorials within an Issue.
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  itemType  String
  itemId    String
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
}

enum IssueCategory {
  POLITY
  GOVERNANCE
  INTERNATIONAL_RELATIONS
  ECONOMY
  AGRICULTURE
  SCIENCE_TECHNOLOGY
  ENVIRONMENT
  INTERNAL_SECURITY
  SOCIETY
  ANCIENT_INDIA
  MEDIEVAL_INDIA
  MODERN_INDIA
  ART_CULTURE
  HISTORY
  GEOGRAPHY
  CULTURE
  ETHICS
  DISASTER_MANAGEMENT
  CURRENT_AFFAIRS
  CSAT
  OPTIONAL
}

enum IssueNodeType {
  NEWS
  CONCEPTUAL
  STATIC
}

enum IssueStatus {
  ACTIVE
  DORMANT
  ARCHIVED
}

enum ContentType {
  NEWS
  PIB
  REPORT
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum ProgressStatus {
  UNSTARTED
  READING
  MASTERED
  REVISION_NEEDED
}

model PreviousYearQuestion {
  id           String                 @id @default(uuid())
  paper        String // GS1, GS2, GS3, GS4, ESSAY, OPTIONAL
  optionalId   String? // Linked if it's an optional paper
  subject      String // GEOGRAPHY, POLITY, etc.
  year         Int
  questionText String                 @db.Text
  marks        Int?
  modelAnswer  String?                @db.Text
  embedding    Unsupported("vector")?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  optional     OptionalSubject?       @relation(fields: [optionalId], references: [id])

  @@index([paper])
  @@index([subject])
  @@index([year])
}
