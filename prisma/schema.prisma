// ─────────────────────────────────────────────────────────────────────────────
// UPSC Atlas Portal — Prisma Schema
// Architecture: Issue Graph Model (V2)
// Database: PostgreSQL on Neon (serverless) with pgvector
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum IssueCategory {
  POLITY
  GOVERNANCE
  INTERNATIONAL_RELATIONS
  ECONOMY
  AGRICULTURE
  SCIENCE_TECHNOLOGY
  ENVIRONMENT
  INTERNAL_SECURITY
  SOCIETY
  HISTORY
  GEOGRAPHY
  CULTURE
  ETHICS
  DISASTER_MANAGEMENT
}

enum IssueNodeType {
  NEWS
  CONCEPTUAL
  STATIC
}

enum IssueStatus {
  ACTIVE
  DORMANT
  ARCHIVED
}

enum ContentType {
  NEWS
  PIB
  REPORT
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ═══════════════════════════════════════════════════════════════════════════════
// AUTH & USER MODELS (Preserved from existing schema)
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id                 String          @id @default(cuid())
  name               String?
  email              String?         @unique
  emailVerified      DateTime?
  image              String?
  role               String?         @default("USER")
  tier               String?         @default("FREE")
  validUntil         DateTime?
  razorpayCustomerId String?         @unique
  username           String?         @unique
  password           String?
  createdAt          DateTime        @default(now())
  preferences        Json?           @default("{}")
  examYear           Int?
  accounts           Account[]
  favorites          FavoriteEntry[]
  sessions           Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id             String   @id @default(cuid())
  userId         String   @unique
  razorpaySubId  String   @unique
  razorpayPlanId String
  status         String
  currentStart   DateTime
  currentEnd     DateTime
}

// ═══════════════════════════════════════════════════════════════════════════════
// MAP & GEOGRAPHY MODELS (Preserved from existing schema)
// ═══════════════════════════════════════════════════════════════════════════════

model FavoriteEntry {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  createdAt DateTime @default(now())
  entry     MapEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
}

model MapEntry {
  id                      String    @id @default(cuid())
  lat                     Float?
  lon                     Float?
  name                    String
  category                String
  tags                    String?
  year                    Int?
  shape                   String?
  prelims                 String?
  mains                   String?
  india                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt
  lastNewsDate            DateTime?
  newsMentions            String?
  aiNodeSummaryFollowups  String?
  aiNodeSummaryMarkdown   String?
  aiNodeSummarySourceHash String?
  aiNodeSummaryTitle      String?
  aiNodeSummaryUpdatedAt  DateTime?
  aiNewsSummaryFollowups  String?
  aiNewsSummaryMarkdown   String?
  aiNewsSummarySourceHash String?
  aiNewsSummaryTitle      String?
  aiNewsSummaryUpdatedAt  DateTime?
  admRegion               String?
  capital                 String?
  continent               String?
  geoGroup                String?
  worldPart               String?   @default("POLITICAL")

  // Three-Layer Mapping Architecture
  nodeSubType      String? // COUNTRY | PHYSICAL | CONFLICT_ZONE | ETHNIC_REGION | STRAIT | PASS | PIPELINE | ROUTE | ORG_HQ
  parentCountry    String? // For sub-national nodes e.g. "Tigray" → "Ethiopia"
  seaBorders       String? // Comma-separated: "Mediterranean Sea,Adriatic Sea"
  riverOutflow     String? // Body of water a river drains into e.g. "Caspian Sea"
  mountainType     String? // Fold | Block | Volcanic | Residual
  highestPeak      String? // Specifically for mountains e.g. "Mount Everest"
  countriesSpread  String? // Specifically for features that spread across multiple countries
  isLandlocked     Boolean? @default(false)
  organizations    String? // Comma-separated org memberships: "NATO,G7,OECD"
  isCurrentAffairs Boolean? @default(false)
  upscFrequency    Int? // Times appeared in PYQs (rough 1-10 scale)

  favoritedBy FavoriteEntry[]

  @@unique([name, lat, lon])
  @@index([name])
  @@index([category])
  @@index([worldPart])
  @@index([nodeSubType])
}

model Organization {
  id          String   @id @default(cuid())
  name        String   @unique // "North Atlantic Treaty Organization"
  shortName   String // "NATO"
  category    String // MILITARY | ECONOMIC | REGIONAL | ENVIRONMENTAL | SCIENTIFIC
  members     String // Comma-separated country names (as they appear in MapEntry.name)
  hqCity      String?
  hqLat       Float?
  hqLon       Float?
  founded     Int?
  description String?
  upscContext String? // Why UPSC tests this; India's relationship
  indiaRole   String? // MEMBER | OBSERVER | DIALOGUE_PARTNER | NOT_MEMBER
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([category])
  @@index([shortName])
}

// ═══════════════════════════════════════════════════════════════════════════════
// NEWS ENGINE — ISSUE GRAPH MODELS (V2 Architecture)
// ═══════════════════════════════════════════════════════════════════════════════

/// The central knowledge node. 545 pre-seeded from UPSC syllabus (GS1–GS4).
/// News items and editorials attach TO Issues. Every new attachment triggers
/// a background rebuild of cumulativeSummary.
model Issue {
  id                String                      @id @default(cuid())
  title             String
  slug              String                      @unique
  domain            String                      // e.g. "POLITY", "ENVIRONMENT" — parent domain
  topic             String                      // parent topic within domain
  category          IssueCategory
  gsPapers          String[]                    // ["GS2", "GS3"]
  nodeType          IssueNodeType               @default(NEWS)
  status            IssueStatus                 @default(ACTIVE)
  backgroundNote    String?                     @db.Text
  cumulativeSummary String?                     @db.Text
  embedding         Unsupported("vector(768)")?
  lastUpdatedAt     DateTime                    @updatedAt
  createdAt         DateTime                    @default(now())

  articles       Article[]
  editorials     Editorial[]
  timelineEvents TimelineEvent[]
  pyqLinks       PYQLink[]

  @@index([category])
  @@index([domain])
  @@index([nodeType])
  @@index([status])
  @@index([slug])
}

/// Manually added news items, linked to an Issue.
/// structuredData holds the full Gemma 26B analysis JSON.
model Article {
  id             String           @id @default(cuid())
  issueId        String
  issue          Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  title          String
  url            String?          @unique
  source         String?          // "Indian Express", "PIB", "The Hindu"
  contentType    ContentType      @default(NEWS)
  rawContent     String?          @db.Text
  structuredData Json?            // Full AI analysis JSON (see schema in KI)
  status         ProcessingStatus @default(PENDING)
  addedManually  Boolean          @default(true)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())

  timelineEvents TimelineEvent[]

  @@index([issueId])
  @@index([status])
  @@index([source])
  @@index([contentType])
  @@index([publishedAt])
}

/// Manually added editorials, linked to an Issue.
/// structuredData holds the editorial-specific Gemma 26B analysis JSON.
model Editorial {
  id             String           @id @default(cuid())
  issueId        String
  issue          Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  title          String
  url            String?
  author         String?
  source         String?          // "Indian Express", "The Hindu", "EPW"
  rawContent     String?          @db.Text
  structuredData Json?            // Full editorial analysis JSON (see schema in KI)
  status         ProcessingStatus @default(PENDING)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())

  @@index([issueId])
  @@index([status])
  @@index([source])
}

/// Auto-generated chronological event thread per Issue.
/// Created whenever a new Article or Editorial is attached.
model TimelineEvent {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  date      DateTime
  eventText String
  sourceUrl String?
  itemType  String   // "NEWS" | "EDITORIAL" | "MANUAL"
  refId     String?  // articleId or editorialId
  createdAt DateTime @default(now())

  article   Article? @relation(fields: [refId], references: [id], onDelete: SetNull)

  @@index([issueId])
  @@index([date])
  @@index([itemType])
}

/// Links Issues to Past Year Questions.
/// Built via pgvector semantic search + Gemma 26B validation.
model PYQLink {
  id            String   @id @default(cuid())
  issueId       String
  issue         Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  paperType     String   // "PRELIMS" | "MAINS"
  year          Int
  gsTag         String?  // "GS2"
  questionText  String   @db.Text
  relevanceNote String?  // AI-written explanation of why this PYQ is relevant
  howToUse      String?  // For Mains PYQs: "Use this editorial's Argument 2 as the critical view"
  score         Float?   // Semantic similarity score
  createdAt     DateTime @default(now())

  @@index([issueId])
  @@index([paperType])
  @@index([year])
}

// ═══════════════════════════════════════════════════════════════════════════════
// OPERATIONAL MODELS
// ═══════════════════════════════════════════════════════════════════════════════

/// Logs all engine operations: ingestion, processing, summary rebuilds, errors.
model ActionLog {
  id         String   @id @default(cuid())
  action     String   // "ARTICLE_ADDED" | "PROCESSING_STARTED" | "SUMMARY_REBUILT" | "EMBEDDING_UPDATED"
  entityType String?  // "Article" | "Editorial" | "Issue"
  entityId   String?  // ID of the entity this log refers to
  status     String   @default("SUCCESS") // "SUCCESS" | "FAILED" | "IN_PROGRESS"
  message    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// PLATFORM MODELS (Preserved from existing schema)
// ═══════════════════════════════════════════════════════════════════════════════

model RegionInsightCache {
  id                 String   @id @default(cuid())
  regionKey          String
  mode               String
  title              String
  contextLabel       String
  markdown           String
  suggestedFollowups String?
  sourceHash         String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@unique([regionKey, mode])
  @@index([regionKey])
  @@index([mode])
}

model QuizPack {
  id                 String   @id @default(cuid())
  scopeType          String
  scopeId            String
  mode               String
  title              String
  contextLabel       String
  markdown           String
  suggestedFollowups String?
  sourceHash         String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@unique([scopeType, scopeId, mode])
  @@index([scopeType, scopeId])
  @@index([mode])
}

model CommunicationLog {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  channel   String
  status    String
  content   String?
  recipient String
  createdAt DateTime @default(now())
}

model PaymentLog {
  id         String   @id @default(cuid())
  userId     String
  razorpayId String
  amount     Int
  currency   String   @default("INR")
  status     String
  createdAt  DateTime @default(now())
}

model PlatformConfig {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model SubjectContent {
  id              String                      @id @default(cuid())
  subject         String
  examType        String // PRELIMS | MAINS | BOTH
  title           String
  contentMarkdown String
  embedding       Unsupported("vector(768)")?
  sourceUrl       String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @default(now()) @updatedAt

  @@index([subject])
  @@index([examType])
}
